#!/bin/bash

eval "$(starship init bash)"
# update go version in place
GoToVersion() {
    VERSION="$1"
    pushd ${HOME}/sdk && \
    go install golang.org/dl/go${VERSION}@latest && \
    go${VERSION} download && \
    rm go && ln -s go${VERSION} go
    popd
}

# personal prefs
alias ls='ls --color'
alias ll='ls -al'